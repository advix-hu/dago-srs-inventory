<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SRSInventory.ContentViews.ProductView"
             xmlns:models="clr-namespace:SRSInventory.Models"
             x:DataType="models:Product"
             x:Name="root"
             xmlns:convertes="clr-namespace:SRSInventory.Converters"
             >
    <ContentView.Resources>
        <convertes:QuantityToForegroundConverter x:Key="QuantityToForegroundConverter"/>
    </ContentView.Resources>

    <Border Padding="10" Stroke="LightGray" StrokeShape="RoundRectangle 8" Margin="5">

        <Border.Shadow>
            <Shadow Radius="10" Opacity="0.2" Offset="0,4" />
        </Border.Shadow>
        
        <Grid BindingContext="{Binding Source={x:Reference root}, Path=Product}" ColumnDefinitions="Auto,Auto,Auto">
            <Label Grid.Column="0" Text="{Binding Name}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0,10,10,10" TextColor="{Binding Quantity, Converter={StaticResource QuantityToForegroundConverter}}"/>
            <Label Grid.Column="1" Text="{Binding Barcode}" FontAttributes="Italic" HorizontalOptions="Start" VerticalOptions="Center" Margin="0,10,10,10" TextColor="{Binding Quantity, Converter={StaticResource QuantityToForegroundConverter}}"/>
            <Label Grid.Column="2" Text="{Binding Quantity, StringFormat='{0} Ft'}}" HorizontalOptions="Start" VerticalOptions="Center" Margin="0,10,10,10" TextColor="{Binding Quantity, Converter={StaticResource QuantityToForegroundConverter}}"/>
        </Grid>
    </Border>

</ContentView>
